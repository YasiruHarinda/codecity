{
  "name": "codecity",
  "version": "0.1.0",
  "description": "Scan a code repository and output city.json for the CodeCity 3D viewer",
  "private": true,
  "type": "module",
  "bin": {
    "codecity": "bin/codecity.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/cli.js"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ignore": "^7.0.13"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
